FROM node:22-bookworm-slim

# Pre-create volume mount targets and chown to 1000:1000 (factory) so named volumes
# inherit non-root permissions and don't fail with EACCES on container start (Fix A2)
RUN mkdir -p /run/factory-auth/architect /run/factory-auth/worker \
  && chown -R 1000:1000 /run/factory-auth

USER 1000:1000
ENTRYPOINT ["node", "/opt/factory/token-refresher.mjs"]
