# 1. Architect Primary Inference Server (OpenAI-compatible)
GLM_UPSTREAM_URL=https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=your_glm_api_key_here

# 2. Architect Vision Inference Server (leave blank to reuse GLM settings above)
VISION_UPSTREAM_URL=
VISION_API_KEY=

# 3. Optional Backup Model (for automatic failover on 429/500/timeouts)
BACKUP_UPSTREAM_URL=
BACKUP_API_KEY=

# 4. Senior Worker Upstream API
SENIOR_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai
SENIOR_API_KEY=your_gemini_api_key_here

# 5. Specialist Fable via Claude Code API (optional: only needed if FABLE_AUTH_MODE=proxy)
ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# 6. Hourly spending limits in llm-proxy
GLM_MAX_REQ_PER_HOUR=240
FABLE_MAX_REQ_PER_HOUR=60
