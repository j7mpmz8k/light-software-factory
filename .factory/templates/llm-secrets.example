# 1. GLM-5.3 Primary Inference Server (OpenAI-compatible — Powers Hub Architect, Orchestrator & worker-glm)
GLM_UPSTREAM_URL=https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=your_glm_api_key_here

# 2. Vision Inference Server for PR Screenshot Inspection (leave blank to reuse GLM settings above)
VISION_UPSTREAM_URL=
VISION_API_KEY=

# 3. Optional Hub Backup Model (automatic failover on 429/500/timeouts)
BACKUP_UPSTREAM_URL=
BACKUP_API_KEY=

# 4. Optional Separate Endpoint/Key for worker-glm (leave blank to reuse GLM settings above)
GLM_WORKER_UPSTREAM_URL=
GLM_WORKER_API_KEY=

# 5. Isolated Hourly Spend Circuit Breakers in llm-proxy
#    (worker-glm has its own bucket so it can never starve Architect/Orchestrator)
GLM_MAX_REQ_PER_HOUR=240
GLM_WORKER_MAX_REQ_PER_HOUR=180
