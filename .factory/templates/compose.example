FACTORY_REPO=your_github_username/your_repo_name
POSTGRES_ADMIN_PASSWORD=change_this_postgres_admin_pw
POSTGRES_AGY_PASSWORD=change_this_agy_pw
POSTGRES_QWEN_PASSWORD=change_this_qwen_pw
POSTGRES_GLM_PASSWORD=change_this_glm_pw

# Internal llm-proxy tokens (generate random strings, e.g. `openssl rand -hex 16`)
ARCHITECT_PROXY_TOKEN=change_this_architect_proxy_tok
GLM_WORKER_PROXY_TOKEN=change_this_worker_glm_proxy_tok

# Control Plane Hub Models (GLM-5.3 — Always-On, Never Blocks Failover)
ARCHITECT_MODEL=glm-5.3
ARCHITECT_VISION_MODEL=glm-5.3-flash
ORCHESTRATOR_MODEL=glm-5.3
ARCHITECT_BACKUP_MODEL=

# Worker Models
AGY_DEFAULT_MODEL=gemini-4-hydrogen-high
QWEN_MODEL=qwen3.8:27b
QWEN_INFERENCE_URL=http://host.docker.internal:11434/v1
GLM_WORKER_MODEL=glm-5.3

# Local Webhook Port
WEBHOOK_PORT=8787
